PORT=3100
GATEWAY_TOKEN=change-me-to-a-long-random-string
SESSIONS_DIR=./sessions

# Laravel inbound webhook (Phase 1 Conversations)
# Production preferred (matches Admin: VITE_API_ADDRESS + /api/v1):
#   https://ekshf.li/api/api/v1/whatsapp_inbound_webhook
# Also works after Laravel dual-mount of the inbound route:
#   https://ekshf.li/api/v1/whatsapp_inbound_webhook
LARAVEL_WEBHOOK_URL=https://ekshf.li/api/api/v1/whatsapp_inbound_webhook
# Must match Laravel WHATSAPP_WEBHOOK_TOKEN and/or WHATSAPP_GATEWAY_TOKEN.
# If empty, GATEWAY_TOKEN is sent instead (Laravel now accepts either secret).
WEBHOOK_TOKEN=

# Railway sets RAILWAY_GIT_COMMIT_SHA automatically — verify in GET /health build_id
WHATSAPP_AUTO_RESTORE=0
LOG_LEVEL=info
WHATSAPP_QR_LOCK_MS=60000
WHATSAPP_PAIRING_RESTART_DELAY_MS=2000
WHATSAPP_QR_SCAN_GRACE_MS=120000
WHATSAPP_STALE_CONNECTING_MS=300000
QR_WAIT_MS=20000
